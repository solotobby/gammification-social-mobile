{
  "expo": {
    "name": "Payhankey",
    "slug": "payhankey",
    "version": "1.6.1",
    "orientation": "portrait",
    "scheme": "payhankey",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/ios-icon-dark.png",
        "tinted": "./assets/ios-icon-tinted.png"
      },
      "bundleIdentifier": "com.payhankey.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.payhankey.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#5A4FDC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-video",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Payhankey uses your camera for video calls and for photos you attach to posts.",
          "microphonePermission": "Payhankey uses your microphone for voice and video calls and for videos you record."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Payhankey needs access to your photos so you can attach them to posts and stories.",
          "cameraPermission": "Payhankey uses your camera for video calls and for photos you attach to posts.",
          "microphonePermission": "Payhankey uses your microphone for voice and video calls and for videos you record."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#5A4FDC",
          "sounds": [
            "./assets/sounds/ringtone.wav"
          ]
        }
      ],
      "expo-task-manager",
      [
        "react-native-notify-kit",
        {
          "android": {
            "foregroundService": {
              "types": [
                "microphone",
                "camera"
              ]
            }
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/PlusJakartaSans_400Regular.ttf",
            "./assets/fonts/PlusJakartaSans_500Medium.ttf",
            "./assets/fonts/PlusJakartaSans_600SemiBold.ttf",
            "./assets/fonts/PlusJakartaSans_700Bold.ttf",
            "./assets/fonts/PlusJakartaSans_800ExtraBold.ttf",
            "./assets/fonts/SpaceMono_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo-light.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#F6F4FF",
          "dark": {
            "image": "./assets/splash-logo-dark.png",
            "backgroundColor": "#0C0820"
          },
          "android": {
            "image": "./assets/splash-mark.png",
            "imageWidth": 150,
            "backgroundColor": "#F6F4FF",
            "dark": {
              "image": "./assets/splash-mark.png",
              "backgroundColor": "#0C0820"
            }
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c8abb113-6ffa-47d8-87e7-4af4074deeda"
      }
    },
    "owner": "payhankey-social"
  }
}
