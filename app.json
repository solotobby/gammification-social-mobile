{
  "expo": {
    "name": "Payhankey",
    "slug": "payhankey",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "payhankey",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/ios-icon-dark.png",
        "tinted": "./assets/ios-icon-tinted.png"
      },
      "bundleIdentifier": "com.payhankey.app"
    },
    "android": {
      "package": "com.payhankey.app",
      "adaptiveIcon": {
        "backgroundColor": "#5A4FDC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Payhankey needs access to your photos so you can attach them to posts and stories."
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo-light.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#F6F4FF",
          "dark": {
            "image": "./assets/splash-logo-dark.png",
            "backgroundColor": "#0C0820"
          },
          "android": {
            "image": "./assets/splash-mark.png",
            "imageWidth": 150,
            "backgroundColor": "#F6F4FF",
            "dark": {
              "image": "./assets/splash-mark.png",
              "backgroundColor": "#0C0820"
            }
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c8abb113-6ffa-47d8-87e7-4af4074deeda"
      }
    },
    "owner": "payhankey-social"
  }
}
